flowchart TD
  A([بداية: فتح لوحة المؤلف]) --> B["قراءة معرف المؤلف من الكوكي"]
  B --> C["مجموع المبيعات = Σ TotalAmount لمبيعات المؤلف"]
  C --> D["مصاريف العمليات = Σ TotalAmount لعمليات المؤلف"]
  D --> E["صافي الربح = مجموع المبيعات − BasicFees − مصاريف العمليات"]
  E --> F["جلب آخر 10 مبيعات و10 عمليات (ترقيم صفحات)"]
  F --> G[/"عرض اللوحة: حالة العقد + البطاقات + الجدولين"/]
  G --> Z([نهاية])
