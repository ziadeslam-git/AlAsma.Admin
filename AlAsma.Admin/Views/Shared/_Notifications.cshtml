@* TempData messages (Success / Error / Warning) rendered as toasts. *@
@functions {
    private static string IconFor(string kind) => kind switch { "success" => "check-circle", "error" => "x-circle", _ => "alert-triangle" };
}
@{
    var messages = new List<(string Kind, string Text)>();
    if (TempData["Success"] is string ok) { messages.Add(("success", ok)); }
    if (TempData["Error"] is string err) { messages.Add(("error", err)); }
    if (TempData["Warning"] is string warn) { messages.Add(("warning", warn)); }
}
@if (messages.Count > 0)
{
    <div class="toasts" role="status" aria-live="polite">
        @foreach (var (kind, text) in messages)
        {
            <div class="toast toast--@kind">
                @Icon.Svg(IconFor(kind), 20)
                <span class="toast__text">@text</span>
                <button type="button" class="toast__close" aria-label="إغلاق">@Icon.Svg("x", 16)</button>
            </div>
        }
    </div>
}
