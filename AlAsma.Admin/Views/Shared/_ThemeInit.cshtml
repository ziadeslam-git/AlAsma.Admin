@* Runs before first paint so there is no light/dark flash. *@
<script>
    (function () {
        try {
            var root = document.documentElement;
            var theme = localStorage.getItem('theme');
            if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) { theme = 'dark'; }
            if (theme === 'dark') { root.setAttribute('data-theme', 'dark'); }
            if (localStorage.getItem('sidebar') === 'rail') { root.setAttribute('data-sidebar', 'rail'); }
        } catch (e) { }
    })();
</script>
