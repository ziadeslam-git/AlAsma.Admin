@model string
@* Sale form fields. Model = "Create" or "Edit". Used by the create drawer, the edit drawer and the Create page. *@
@{
    var mode = Model;
    var authors = ViewBag.Authors as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var formId = mode.ToLowerInvariant() + "-sale-form";
}
<form id="@formId" asp-area="Admin" asp-controller="Sale" asp-action="@mode" method="post" data-once class="sale-form">
    @if (mode == "Edit")
    {
        <input type="hidden" name="Id" value="0" />
    }
    <div class="drawer__body">
        <div class="field">
            <label class="field__label" for="@formId-title">اسم الكتاب<span class="req">*</span></label>
            <input class="input" id="@formId-title" name="BookTitle" maxlength="200" required placeholder="أدخل اسم الكتاب" autocomplete="off" />
        </div>
        <div class="field">
            <label class="field__label" for="@formId-author">الكاتب<span class="req">*</span></label>
            <select class="select" id="@formId-author" name="AuthorId" required>
                <option value="">اختر المؤلف</option>
                @foreach (var author in authors)
                {
                    <option value="@author.Value">@author.Text</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field__label" for="@formId-store">منفذ البيع<span class="req">*</span></label>
            <input class="input" id="@formId-store" name="StoreLocation" maxlength="200" required placeholder="مثال: المكتب الرئيسي" autocomplete="off" />
        </div>
        <div class="form-grid">
            <div class="field">
                <label class="field__label" for="@formId-price">سعر البيع (ج.م)<span class="req">*</span></label>
                <input class="input input--num" id="@formId-price" name="SalePrice" type="number" step="0.01" min="0.01" required placeholder="0.00" inputmode="decimal" />
            </div>
            <div class="field">
                <label class="field__label" for="@formId-qty">الكمية<span class="req">*</span></label>
                <input class="input input--num" id="@formId-qty" name="Quantity" type="number" min="1" step="1" value="1" required inputmode="numeric" />
            </div>
        </div>
        <div class="field">
            <label class="field__label" for="@formId-exp">مصروفات إضافية للنسخة (ج.م)</label>
            <input class="input input--num" id="@formId-exp" name="BasicExpenses" type="number" step="0.01" min="0" value="0" inputmode="decimal" />
            <span class="field__hint">تُضرب في الكمية وتُخصم من إجمالي العملية.</span>
        </div>
    </div>
    <div class="drawer__foot">
        <div class="live-total">
            <span class="live-total__label">المجموع النهائي</span>
            <span class="live-total__value" data-total="sale">0.00</span><span class="cur">ج.م</span>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn--secondary" data-close>إلغاء</button>
            <button type="submit" class="btn btn--primary">@Icon.Svg("check-circle", 18)@(mode == "Edit" ? "حفظ التعديل" : "حفظ العملية")</button>
        </div>
    </div>
</form>
