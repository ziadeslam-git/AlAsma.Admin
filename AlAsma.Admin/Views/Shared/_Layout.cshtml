@{
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#004743" />
    <title>@ViewData["Title"] — الأسمى للنشر والتوزيع</title>
    <link rel="icon" type="image/svg+xml" href="~/images/brand/asma-feather-green.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <partial name="_ThemeInit" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">تخطَّ إلى المحتوى</a>
    <div class="app">
        @if (authenticated)
        {
            <partial name="_Sidebar" />
            <partial name="_TopBar" />
        }

        <main class="app__main" id="main">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        @if (authenticated)
        {
            <partial name="_BottomBar" />
            <partial name="_MoreSheet" />
            @if (User.IsInRole("Author"))
            {
                <partial name="_ReportSheet" />
            }
        }
    </div>

    @await RenderSectionAsync("Overlays", required: false)
    <partial name="_Notifications" />
    <div class="scrim"></div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
