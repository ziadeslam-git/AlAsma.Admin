@model PagerModel
@{
    var current = Math.Max(1, Model.Current);
    var total = Math.Max(1, Model.TotalPages);
    var from = Model.TotalCount == 0 ? 0 : ((current - 1) * Model.PageSize) + 1;
    var to = Math.Min(current * Model.PageSize, Model.TotalCount);
    var start = Math.Max(1, current - 2);
    var end = Math.Min(total, current + 2);
}
<div class="card__foot">
    <span class="pager-info">عرض @from إلى @to من @Model.TotalCount سجل</span>
    @if (total > 1)
    {
        <nav class="pager" aria-label="الترقيم">
            <a class="pager__btn" href="@Model.UrlFor(Math.Max(1, current - 1))" aria-label="السابق" aria-disabled="@(current == 1 ? "true" : "false")">@Icon.Svg("chevron-right", 18)</a>
            @if (start > 1)
            {
                <a class="pager__btn" href="@Model.UrlFor(1)">1</a>
                if (start > 2) { <span class="pager__gap">…</span> }
            }
            @for (var i = start; i <= end; i++)
            {
                <a class="pager__btn@(i == start || i == end || i == current ? "" : " pager__hide-sm")" href="@Model.UrlFor(i)" aria-current="@(i == current ? "page" : null)">@i</a>
            }
            @if (end < total)
            {
                if (end < total - 1) { <span class="pager__gap">…</span> }
                <a class="pager__btn" href="@Model.UrlFor(total)">@total</a>
            }
            <a class="pager__btn" href="@Model.UrlFor(Math.Min(total, current + 1))" aria-label="التالي" aria-disabled="@(current == total ? "true" : "false")">@Icon.Svg("chevron-left", 18)</a>
        </nav>
    }
</div>
