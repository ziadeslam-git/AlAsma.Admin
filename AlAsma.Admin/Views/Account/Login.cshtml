@model LoginDto
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
    var hasErrors = !ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry.Errors.Count > 0;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#004743" />
    <title>@ViewData["Title"] — الأسمى للنشر والتوزيع</title>
    <link rel="icon" type="image/svg+xml" href="~/images/brand/asma-feather-green.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <partial name="_ThemeInit" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <section class="auth__brand">
            <img class="auth__brand-mark" src="~/images/brand/asma-feather-cream.svg" alt="" aria-hidden="true" />
            <div class="auth__brand-inner">
                <img class="auth__lockup" src="~/images/brand/asma-lockup-cream.svg" alt="شعار دار الأسمى للنشر والتوزيع" />
                <p class="auth__slogan">نقطة.. فكرة.. وأثر لا يزول!</p>
                <ul class="auth__features">
                    <li>@Icon.Svg("trending-up", 22)<span>تابع مبيعاتك وأرباحك لحظة بلحظة</span></li>
                    <li>@Icon.Svg("file-text", 22)<span>عقودك وتقاريرك في مكان واحد</span></li>
                    <li>@Icon.Svg("download", 22)<span>تصدير PDF وWord بضغطة واحدة</span></li>
                </ul>
            </div>
        </section>

        <section class="auth__panel">
            <div class="auth__card">
                <div>
                    <h1 class="auth__title">تسجيل الدخول</h1>
                    <p class="muted" style="margin-top:4px">أهلاً بك في نظام إدارة المبيعات والمؤلفين</p>
                </div>

                @if (hasErrors)
                {
                    <div class="auth__alert" role="alert">
                        @Icon.Svg("alert-triangle", 20)
                        <span>@Html.ValidationSummary(true)</span>
                    </div>
                }

                <form class="auth__form" asp-controller="Account" asp-action="Login" method="post" data-once novalidate>
                    <div class="field">
                        <label class="field__label" asp-for="Code">كود المستخدم</label>
                        <input class="input" asp-for="Code" placeholder="أدخل الكود الخاص بك" autocomplete="username" autofocus />
                        <span class="field__error" asp-validation-for="Code"></span>
                    </div>

                    <div class="field">
                        <label class="field__label" asp-for="Password">كلمة المرور</label>
                        <div class="input-wrap">
                            <input class="input" asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="input-wrap__btn" data-toggle-password aria-label="إظهار كلمة المرور">
                                <span data-icon-show>@Icon.Svg("eye", 20)</span>
                                <span data-icon-hide hidden>@Icon.Svg("eye-off", 20)</span>
                            </button>
                        </div>
                        <span class="field__error" asp-validation-for="Password"></span>
                    </div>

                    <button type="submit" class="btn btn--primary btn--block" style="min-height:52px;font-size:16px">دخول للنظام</button>
                </form>

                <div class="auth__help">
                    <span>تحتاج مساعدة؟ تواصل مع الدعم الفني</span>
                    <a class="btn btn--secondary btn--sm" href="https://wa.me/201005340021" target="_blank" rel="noopener noreferrer">
                        @Icon.Svg("message", 16)واتساب
                    </a>
                </div>
            </div>
        </section>
    </div>

    <partial name="_Notifications" />
    <div class="scrim"></div>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
