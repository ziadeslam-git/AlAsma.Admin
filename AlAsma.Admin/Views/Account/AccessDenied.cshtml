@{
    Layout = null;
    ViewData["Title"] = "غير مصرح";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#004743" />
    <title>غير مصرح — الأسمى للنشر والتوزيع</title>
    <link rel="icon" type="image/svg+xml" href="~/images/brand/asma-feather-green.svg" />
    <partial name="_ThemeInit" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <main class="state-page">
        <div class="state-page__card">
            <img class="state-page__mark" src="~/images/brand/asma-feather-green.svg" alt="" aria-hidden="true" />
            <div class="state-page__code num">403</div>
            <h1 style="font:var(--text-h3)">غير مصرح لك بالدخول</h1>
            <p class="muted">ليس لديك صلاحية للوصول إلى هذه الصفحة.</p>
            <div class="btn-group" style="justify-content:center;margin-top:12px">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn--primary" href="/">@Icon.Svg("home", 18)العودة للرئيسية</a>
                }
                <a class="btn btn--secondary" asp-area="" asp-controller="Account" asp-action="Login">@Icon.Svg("log-out", 18)تسجيل الدخول بحساب آخر</a>
            </div>
        </div>
    </main>
</body>
</html>
