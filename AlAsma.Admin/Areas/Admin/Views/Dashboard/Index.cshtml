@model AdminDashboardDto
@* Shared by Admin and SuperAdmin (the SuperAdmin controller renders this same view). *@
@{
    ViewData["Title"] = "لوحة المبيعات";
    var contractsTotal = Model.ActiveContracts + Model.EndingSoonContracts + Model.ExpiredContracts;
    var activePct = contractsTotal == 0 ? 0 : (double)Model.ActiveContracts * 100 / contractsTotal;
    var soonPct = contractsTotal == 0 ? 0 : (double)Model.EndingSoonContracts * 100 / contractsTotal;
    var donutBackground = contractsTotal == 0
        ? "var(--line)"
        : FormattableString.Invariant($"conic-gradient(var(--success-ink) 0 {activePct:0.##}%, var(--accent) {activePct:0.##}% {activePct + soonPct:0.##}%, var(--danger-ink) {activePct + soonPct:0.##}% 100%)");
    var averageSale = Model.TotalSales > 0 ? Model.TotalRevenue / Model.TotalSales : 0m;
    var revenuePerAuthor = Model.TotalAuthors > 0 ? Model.TotalRevenue / Model.TotalAuthors : 0m;
    var recentBars = Model.RecentSales.OrderBy(s => s.SaleDate).ToList();
    var maxBar = recentBars.Any() ? recentBars.Max(s => s.TotalAmount) : 0m;
}

<header class="page-head">
    <div>
        <h1 class="page-head__title greeting">مرحباً، @User.Identity?.Name</h1>
        <p class="page-head__sub">لوحة المبيعات — نظرة سريعة على أداء الدار</p>
    </div>
    <div class="page-head__actions">
        <span class="date-chip">@Icon.Svg("calendar", 18)<span class="num">@DateTime.Now.ToString("dd/MM/yyyy")</span></span>
        <a class="btn btn--primary" asp-area="Admin" asp-controller="Sale" asp-action="Create">@Icon.Svg("plus", 18)عملية جديدة</a>
    </div>
</header>

<section class="kpi-grid kpi-grid--hero kpi-grid--swipe" aria-label="المؤشرات الرئيسية">
    <partial name="_Kpi" model='new KpiModel("الإيراد الخام", Format.Whole(Model.TotalRevenue), "ج.م", "قبل خصم المصروفات · مجموع سعر البيع × الكمية", Hero: true, Tip: "الإيراد الخام: قبل خصم المصروفات")' />
    <partial name="_Kpi" model='new KpiModel("عدد العمليات", Model.TotalSales.ToString(), Note: "عملية بيع مسجلة")' />
    <partial name="_Kpi" model='new KpiModel("متوسط البيع", Format.Whole(averageSale), "ج.م", "لكل عملية")' />
    <partial name="_Kpi" model='new KpiModel("المؤلفون", Model.TotalAuthors.ToString(), Note: "إيراد المؤلف الواحد ≈ " + Format.Whole(revenuePerAuthor) + " ج.م")' />
</section>

@if (Model.ExpiringAuthors.Any())
{
    <section class="alert-strip" role="status" style="flex-direction:column;align-items:flex-start">
        <span style="display:flex;align-items:center;gap:8px">@Icon.Svg("clock", 20)عقود تنتهي قريباً (@Model.ExpiringAuthors.Count)</span>
        <div class="alert-strip__list">
            @foreach (var author in Model.ExpiringAuthors)
            {
                <a class="badge badge--warning" asp-area="Admin" asp-controller="Sale" asp-action="ByAuthor" asp-route-authorId="@author.Id">
                    @author.Name · <span class="num">@author.DaysRemaining</span> يوم
                </a>
            }
        </div>
    </section>
}

<div class="grid-2">
    <section class="card">
        <div class="card__head">
            <h2 class="card__title">@Icon.Svg("trending-up", 20)اتجاه آخر المبيعات</h2>
            <span class="muted" style="font-size:13px">صافي كل عملية · ج.م</span>
        </div>
        <div class="card__body">
            @if (recentBars.Any())
            {
                <div class="spark" role="img" aria-label="رسم شريطي لآخر المبيعات">
                    @foreach (var sale in recentBars)
                    {
                        var height = maxBar <= 0 ? 6 : Math.Max(6, (int)Math.Round((double)(sale.TotalAmount / maxBar) * 100));
                        <div class="spark__col" title="@sale.BookTitle — @Format.Money(sale.TotalAmount) ج.م">
                            <span class="num" style="font-size:12px;font-weight:700">@Format.Whole(sale.TotalAmount)</span>
                            <div class="spark__bar" style="height:@(height)%"></div>
                            <span class="spark__label num">@sale.SaleDate.ToString("dd/MM")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <partial name="_EmptyState" model='new EmptyModel("لا توجد مبيعات بعد", "ستظهر آخر العمليات هنا فور تسجيلها", true)' />
            }
        </div>
    </section>

    <section class="card">
        <div class="card__head"><h2 class="card__title">@Icon.Svg("layers", 20)حالة العقود</h2></div>
        <div class="card__body">
            <div class="donut-wrap">
                <div class="donut" style="background:@donutBackground" role="img" aria-label="توزيع العقود">
                    <div class="donut__hole"><span class="donut__num">@contractsTotal</span><span class="donut__cap">عقد</span></div>
                </div>
                <div class="legend">
                    <div class="legend__row"><span class="legend__dot" style="background:var(--success-ink)"></span>نشطة<span class="legend__val">@Model.ActiveContracts</span></div>
                    <div class="legend__row"><span class="legend__dot" style="background:var(--accent)"></span>تنتهي قريباً<span class="legend__val">@Model.EndingSoonContracts</span></div>
                    <div class="legend__row"><span class="legend__dot" style="background:var(--danger-ink)"></span>منتهية<span class="legend__val">@Model.ExpiredContracts</span></div>
                </div>
            </div>
        </div>
    </section>
</div>

<section class="card">
    <div class="card__head">
        <h2 class="card__title">@Icon.Svg("receipt", 20)آخر المبيعات</h2>
        <a class="btn btn--ghost" asp-area="Admin" asp-controller="Sale" asp-action="Index">عرض الكل</a>
    </div>
    @if (Model.RecentSales.Any())
    {
        <div class="list-rows">
            @foreach (var sale in Model.RecentSales)
            {
                <div class="list-row">
                    <div class="list-row__main">
                        <div class="list-row__title">@sale.BookTitle</div>
                        <div class="cell-stack__sub">@sale.AuthorName<span class="code-chip">@sale.AuthorCode</span></div>
                    </div>
                    <div class="list-row__side">
                        <div class="list-row__amount">@Format.Money(sale.TotalAmount)<span class="cur">ج.م</span></div>
                        <div class="muted num" style="font-size:13px">@Format.DateTimeStamp(sale.SaleDate)</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyModel("لا توجد مبيعات بعد", "سجّل أول عملية بيع لتظهر هنا")' />
    }
</section>
