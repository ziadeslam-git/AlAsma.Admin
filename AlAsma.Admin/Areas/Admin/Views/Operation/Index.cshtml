@model IEnumerable<OperationListDto>
@using System.Text.Json
@{
    ViewData["Title"] = "العمليات";
    ViewData["Heading"] = "العمليات";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : 0;
    var totalExpenses = ViewBag.TotalExpenses is decimal te ? te : 0m;
    var totalSales = ViewBag.TotalSales is decimal ts ? ts : 0m;
    var netProfit = ViewBag.NetProfit is decimal np ? np : 0m;
    string query = ViewBag.SearchQuery ?? string.Empty;
    string field = ViewBag.SearchField ?? "operation";
    var filtered = !string.IsNullOrWhiteSpace(query);
    string PageUrl(int p) => Url.Action("Index", new { page = p, q = query, field })!;

    string EditJson(OperationListDto o) => JsonSerializer.Serialize(new { Id = o.Id, OperationName = o.OperationName, BookTitle = o.BookTitle == "نفقة عامة" ? "" : o.BookTitle, AuthorId = o.AuthorId, ExpenseAmount = o.ExpenseAmount, Quantity = o.Quantity });
    string DeleteJson(OperationListDto o) => JsonSerializer.Serialize(new { id = o.Id, name = o.OperationName, book = o.BookTitle, total = Format.Money(o.TotalAmount) + " ج.م" });
    var fields = new[] { ("operation", "بيان العملية"), ("book", "الكتاب"), ("author", "الكاتب"), ("code", "كود الكاتب") };
}

<header class="page-head">
    <div>
        <h1 class="page-head__title">العمليات التشغيلية</h1>
        <p class="page-head__sub">المصروفات المرتبطة بمؤلف أو كتاب، أو نفقات عامة للدار</p>
    </div>
    <div class="page-head__actions">
        <div class="menu">
            <button type="button" class="btn btn--secondary" data-menu aria-haspopup="true" aria-expanded="false">@Icon.Svg("download", 18)تصدير</button>
            <div class="menu__panel" role="menu">
                <a class="menu__item" role="menuitem" asp-action="ExportPdf">@Icon.Svg("file-text", 18)تصدير PDF</a>
                <a class="menu__item" role="menuitem" asp-action="Export">@Icon.Svg("download", 18)تصدير Word</a>
            </div>
        </div>
        <button type="button" class="btn btn--primary" data-open="operation-drawer" data-reset>@Icon.Svg("plus", 18)عملية جديدة</button>
    </div>
</header>

<section class="kpi-grid kpi-grid--hero" aria-label="مؤشرات العمليات">
    <div class="kpi kpi--hero@(netProfit < 0 ? " kpi--loss" : "")">
        <img class="kpi__mark" src="~/images/brand/asma-feather-cream.svg" alt="" aria-hidden="true" />
        <span class="kpi__icon" aria-hidden="true">@Icon.Svg("trending-up", 22)</span>
        <span class="kpi__label">@(netProfit < 0 ? "صافي الخسارة" : "صافي الأرباح")<span class="tip" title="إجمالي المبيعات − (مصاريف العمليات + مصروفات المبيعات)" tabindex="0">i</span></span>
        <b class="kpi__value num">@Format.Money(netProfit)<span class="cur">ج.م</span></b>
        <span class="kpi__note">المبيعات الخام ناقص كل المصاريف</span>
    </div>
    <partial name="_Kpi" model='new KpiModel("إجمالي المصاريف", Format.Money(totalExpenses), "ج.م", "عمليات + مصروفات المبيعات", IconName: "wallet")' />
    <partial name="_Kpi" model='new KpiModel("إجمالي المبيعات (خام)", Format.Money(totalSales), "ج.م", "قبل خصم المصروفات", Tip: "الإيراد الخام: قبل خصم المصروفات", IconName: "trending-up")' />
    <partial name="_Kpi" model='new KpiModel("عدد العمليات", totalCount.ToString(), Note: filtered ? "حسب البحث الحالي" : "عملية مسجلة", IconName: "receipt")' />
</section>

<section class="card">
    <div class="toolbar">
        <form class="toolbar__search" method="get" asp-action="Index" role="search">
            <label class="searchbar">
                @Icon.Svg("search", 20)
                <input type="search" name="q" value="@query" placeholder="ابحث في العمليات..." aria-label="بحث" />
                @if (filtered)
                {
                    <a class="searchbar__clear" asp-action="Index" asp-route-field="@field" aria-label="مسح البحث">@Icon.Svg("x", 18)</a>
                }
            </label>
            <div class="filter-chips" role="radiogroup" aria-label="البحث في">
                @foreach (var (value, label) in fields)
                {
                    <label class="chip-radio">
                        <input type="radio" name="field" value="@value" checked="@(field == value)" />
                        <span class="chip">@label</span>
                    </label>
                }
            </div>
            <button type="submit" class="sr-only">بحث</button>
        </form>
        <span class="muted toolbar__hint" style="font-size:14px">اضغط Enter للبحث</span>
    </div>

    @if (Model.Any())
    {
        <div class="table-wrap table-wrap--responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>بيان العملية</th><th>الكتاب</th><th>المؤلف</th><th class="col-num">التكلفة</th>
                        <th class="col-num">الكمية</th><th class="col-num">الإجمالي</th><th>التاريخ</th><th class="col-actions"><span class="sr-only">إجراءات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in Model)
                    {
                        <tr>
                            <td><b>@op.OperationName</b></td>
                            <td>@op.BookTitle</td>
                            <td>
                                <div class="cell-stack">
                                    <span>@op.AuthorName</span>
                                    @if (op.AuthorId.HasValue) { <span class="cell-stack__sub"><span class="code-chip">@op.AuthorCode</span></span> }
                                </div>
                            </td>
                            <td class="col-num muted">@Format.Money(op.ExpenseAmount)</td>
                            <td class="col-num">@op.Quantity</td>
                            <td class="col-num strong">@Format.Money(op.TotalAmount)<span class="cur">ج.م</span></td>
                            <td class="num muted nowrap" style="font-size:14px">@Format.DateTimeStamp(op.OperationDate)</td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <button type="button" class="btn btn--icon" data-edit="@EditJson(op)" data-edit-target="operation-edit" title="تعديل" aria-label="تعديل @op.OperationName">@Icon.Svg("pencil", 20)</button>
                                    @if (isSuperAdmin)
                                    {
                                        <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@op.Id" data-delete="@DeleteJson(op)" data-delete-target="delete-operation" title="حذف" aria-label="حذف @op.OperationName">@Icon.Svg("trash", 20)</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mcards">
            @foreach (var op in Model)
            {
                <article class="mcard">
                    <div class="mcard__top">
                        <div class="cell-stack">
                            <div class="mcard__title">@op.OperationName</div>
                            <span class="cell-stack__sub">@op.AuthorName</span>
                        </div>
                        <div class="mcard__total">@Format.Money(op.TotalAmount)<span class="cur">ج.م</span></div>
                    </div>
                    <dl class="mcard__meta">
                        <div><dt>الكتاب</dt><dd>@op.BookTitle</dd></div>
                        <div><dt>التكلفة</dt><dd>@Format.Money(op.ExpenseAmount)</dd></div>
                        <div><dt>الكمية</dt><dd>@op.Quantity</dd></div>
                    </dl>
                    <div class="mcard__foot">
                        <span class="mcard__date num">@Format.DateTimeStamp(op.OperationDate)</span>
                        <div class="row-actions">
                            <button type="button" class="btn btn--icon" data-edit="@EditJson(op)" data-edit-target="operation-edit" aria-label="تعديل">@Icon.Svg("pencil", 20)</button>
                            @if (isSuperAdmin)
                            {
                                <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@op.Id" data-delete="@DeleteJson(op)" data-delete-target="delete-operation" aria-label="حذف">@Icon.Svg("trash", 20)</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <partial name="_Pagination" model="new PagerModel(currentPage, totalPages, totalCount, 10, PageUrl)" />
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyModel(filtered ? "لا توجد نتائج مطابقة" : "لا توجد عمليات بعد", filtered ? "جرّب كلمة أخرى أو غيّر حقل البحث" : "سجّل أول عملية تشغيلية لتظهر هنا")' />
    }
</section>

<button type="button" class="fab" data-open="operation-drawer" data-reset aria-label="عملية جديدة">@Icon.Svg("plus", 26)</button>

@section Overlays {
    <aside class="drawer" id="operation-drawer" role="dialog" aria-modal="true" aria-labelledby="operation-drawer-title" aria-hidden="true">
        <div class="drawer__head">
            <h2 class="drawer__title" id="operation-drawer-title">إضافة عملية تشغيلية</h2>
            <button type="button" class="btn btn--icon" data-close aria-label="إغلاق">@Icon.Svg("x", 20)</button>
        </div>
        <partial name="_OperationForm" model='"Create"' />
    </aside>

    <aside class="drawer" id="operation-edit" role="dialog" aria-modal="true" aria-labelledby="operation-edit-title" aria-hidden="true">
        <div class="drawer__head">
            <h2 class="drawer__title" id="operation-edit-title">تعديل العملية</h2>
            <button type="button" class="btn btn--icon" data-close aria-label="إغلاق">@Icon.Svg("x", 20)</button>
        </div>
        <partial name="_OperationForm" model='"Edit"' />
    </aside>

    @if (isSuperAdmin)
    {
        <partial name="_DeleteModal" model='new DeleteModalModel("delete-operation", "حذف العملية؟", "الحذف نهائي ولا يمكن التراجع عنه.", "Admin", "Operation",
            new List<KeyValuePair<string, string>> { new("name", "العملية"), new("book", "الكتاب"), new("total", "الإجمالي") })' />
    }
}
