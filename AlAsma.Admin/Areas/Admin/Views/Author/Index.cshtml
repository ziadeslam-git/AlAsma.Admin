@model IEnumerable<AuthorListDto>
@using System.Text.Json
@{
    ViewData["Title"] = "المؤلفون";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : 0;
    string status = ViewBag.Status as string ?? "";
    string PageUrl(int p) => Url.Action("Index", new { page = p, status = status == "" ? null : status })!;
    var statusFilters = new[] { ("", "الكل"), ("active", "نشط"), ("soon", "ينتهي قريباً"), ("expired", "منتهي") };

    double Progress(AuthorListDto a)
    {
        if (!a.ContractStart.HasValue || !a.ContractEnd.HasValue || a.ContractEnd <= a.ContractStart) return 0;
        var span = (a.ContractEnd.Value - a.ContractStart.Value).TotalDays;
        return Math.Clamp((DateTime.UtcNow - a.ContractStart.Value).TotalDays / span * 100, 0, 100);
    }
    string Barcolor(string status) => status == "منتهي" ? "var(--danger-ink)" : status == "ينتهي قريباً" ? "var(--accent)" : "var(--green-500)";
}

<header class="page-head">
    <div>
        <h1 class="page-head__title">المؤلفون</h1>
        <p class="page-head__sub">@(isSuperAdmin ? "إدارة المؤلفين وعقودهم" : "عرض المؤلفين وعقودهم (للقراءة فقط)")</p>
    </div>
    <div class="page-head__actions">
        @if (isSuperAdmin)
        {
            <a class="btn btn--primary" asp-action="Create">@Icon.Svg("plus", 18)مؤلف جديد</a>
        }
    </div>
</header>

<section class="card" data-filter-scope>
    <div class="toolbar">
        <div class="toolbar__search">
            <label class="searchbar">
                @Icon.Svg("search", 20)
                <input type="search" data-filter-input placeholder="ابحث بالاسم أو الكود في هذه الصفحة..." aria-label="بحث في المؤلفين" />
            </label>
            <div class="filter-chips" role="group" aria-label="تصفية حسب حالة العقد">
                @foreach (var (value, label) in statusFilters)
                {
                    <a class="chip@(status == value ? " chip--active" : "")" asp-action="Index" asp-route-status="@(value == "" ? null : value)" aria-current="@(status == value ? "true" : null)">@label</a>
                }
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-wrap table-wrap--responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>المؤلف</th><th>العقد</th><th>الحالة</th>
                        <th class="col-num">الرسوم الأساسية</th><th class="col-num">المبيعات</th><th class="col-num">العمليات</th><th class="col-actions"><span class="sr-only">إجراءات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var author in Model)
                    {
                        var data = JsonSerializer.Serialize(new { id = author.Id, name = author.Name, code = author.Code });
                        <tr data-filter-row data-search="@(author.Name + " " + author.Code)" data-status="@author.ContractStatus">
                            <td>
                                <div class="cell-stack">
                                    <b>@author.Name</b>
                                    <span class="cell-stack__sub"><span class="code-chip">@author.Code</span></span>
                                </div>
                            </td>
                            <td style="min-width:200px">
                                <div class="cell-stack">
                                    <span class="num" style="font-size:14px">@(author.ContractStart.HasValue ? Format.Date(author.ContractStart.Value) : "—") ← @(author.ContractEnd.HasValue ? Format.Date(author.ContractEnd.Value) : "—")</span>
                                    <span class="progress" aria-hidden="true"><span class="progress__bar" style="width:@(Progress(author).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:@Barcolor(author.ContractStatus)"></span></span>
                                </div>
                            </td>
                            <td>
                                <div class="cell-stack">
                                    @Badges.Contract(author.ContractStatus)
                                    @if (author.DaysRemaining.HasValue)
                                    {
                                        <span class="cell-stack__sub num">متبقي @author.DaysRemaining يوم</span>
                                    }
                                </div>
                            </td>
                            <td class="col-num">@Format.Money(author.BasicFees)<span class="cur">ج.م</span></td>
                            <td class="col-num">@author.SalesCount</td>
                            <td class="col-num">@author.OperationsCount</td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="btn btn--icon" asp-area="Admin" asp-controller="Sale" asp-action="ByAuthor" asp-route-authorId="@author.Id" title="عرض صفحة المؤلف" aria-label="عرض صفحة @author.Name">@Icon.Svg("eye", 20)</a>
                                    @if (isSuperAdmin)
                                    {
                                        <a class="btn btn--icon" asp-action="Edit" asp-route-id="@author.Id" title="تعديل" aria-label="تعديل @author.Name">@Icon.Svg("pencil", 20)</a>
                                        <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@author.Id" data-delete="@data" data-delete-target="delete-author" title="حذف" aria-label="حذف @author.Name">@Icon.Svg("trash", 20)</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mcards">
            @foreach (var author in Model)
            {
                var data = JsonSerializer.Serialize(new { id = author.Id, name = author.Name, code = author.Code });
                <article class="mcard" data-filter-row data-search="@(author.Name + " " + author.Code)" data-status="@author.ContractStatus">
                    <div class="mcard__top">
                        <div class="cell-stack">
                            <div class="mcard__title">@author.Name</div>
                            <span class="cell-stack__sub"><span class="code-chip">@author.Code</span></span>
                        </div>
                        @Badges.Contract(author.ContractStatus)
                    </div>
                    <dl class="mcard__meta">
                        <div><dt>نهاية العقد</dt><dd>@(author.ContractEnd.HasValue ? Format.Date(author.ContractEnd.Value) : "—")</dd></div>
                        <div><dt>الرسوم</dt><dd>@Format.Money(author.BasicFees)</dd></div>
                        <div><dt>المبيعات</dt><dd>@author.SalesCount</dd></div>
                    </dl>
                    <div class="mcard__foot">
                        <span class="progress" aria-hidden="true" style="flex:1"><span class="progress__bar" style="width:@(Progress(author).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;background:@Barcolor(author.ContractStatus)"></span></span>
                        <div class="row-actions">
                            <a class="btn btn--icon" asp-area="Admin" asp-controller="Sale" asp-action="ByAuthor" asp-route-authorId="@author.Id" aria-label="عرض">@Icon.Svg("eye", 20)</a>
                            @if (isSuperAdmin)
                            {
                                <a class="btn btn--icon" asp-action="Edit" asp-route-id="@author.Id" aria-label="تعديل">@Icon.Svg("pencil", 20)</a>
                                <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@author.Id" data-delete="@data" data-delete-target="delete-author" aria-label="حذف">@Icon.Svg("trash", 20)</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
        <div class="empty empty--compact" data-filter-empty hidden>
            <b class="empty__title">لا توجد نتائج مطابقة</b>
            <span>جرّب كلمة أخرى أو غيّر التصفية</span>
        </div>
        <partial name="_Pagination" model="new PagerModel(currentPage, totalPages, totalCount, 10, PageUrl)" />
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyModel(status != "" ? "لا يوجد مؤلفون بهذه الحالة" : "لا يوجد مؤلفون بعد", status != "" ? "غيّر التصفية لعرض باقي المؤلفين" : (isSuperAdmin ? "أضف أول مؤلف لتبدأ تسجيل المبيعات" : "سيظهر المؤلفون هنا عند إضافتهم"))' />
    }
</section>

@if (isSuperAdmin)
{
    @section Overlays {
        <partial name="_DeleteModal" model='new DeleteModalModel("delete-author", "حذف المؤلف؟", "سيُحذف حساب المؤلف حذفاً ناعماً: يختفي من القوائم وتبقى مبيعاته وعملياته محفوظة.", "Admin", "Author",
            new List<KeyValuePair<string, string>> { new("name", "الاسم"), new("code", "الكود") })' />
    }
}
