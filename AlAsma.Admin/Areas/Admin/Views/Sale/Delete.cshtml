@model SaleListDto
@* Fallback delete-confirmation page (the list page normally uses a modal). *@
@{
    ViewData["Title"] = "تأكيد حذف العملية";
}
<section class="card confirm-card">
    <form asp-area="Admin" asp-controller="Sale" asp-action="Delete" method="post" data-once>
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="modal__head">
            <span class="modal__icon modal__icon--danger">@Icon.Svg("trash")</span>
            <div>
                <h1 class="modal__title">حذف عملية البيع؟</h1>
                <p class="modal__text">الحذف نهائي ولا يمكن التراجع عنه.</p>
            </div>
        </div>
        <div class="modal__body">
            <dl class="facts">
                <div class="facts__row"><dt>الكتاب</dt><dd>@Model.BookTitle</dd></div>
                <div class="facts__row"><dt>المؤلف</dt><dd>@Model.AuthorName</dd></div>
                <div class="facts__row"><dt>الإجمالي</dt><dd class="num">@Format.Money(Model.TotalAmount) ج.م</dd></div>
                <div class="facts__row"><dt>التاريخ</dt><dd class="num">@Format.DateTimeStamp(Model.SaleDate)</dd></div>
            </dl>
        </div>
        <div class="modal__foot">
            <a class="btn btn--secondary" asp-action="Index">إلغاء</a>
            <button type="submit" class="btn btn--danger">@Icon.Svg("trash", 18)حذف نهائي</button>
        </div>
    </form>
</section>
