@model IEnumerable<SaleListDto>
@using System.Text.Json
@{
    ViewData["Title"] = "المبيعات";
    ViewData["Heading"] = "سجل المبيعات";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : 0;
    var totalRevenue = ViewBag.TotalRevenue is decimal tr ? tr : 0m;
    var totalExpenses = ViewBag.TotalExpenses is decimal te ? te : 0m;
    var totalQuantity = ViewBag.TotalQuantity is int tq ? tq : 0;
    string query = ViewBag.SearchQuery ?? string.Empty;
    string field = ViewBag.SearchField ?? "book";
    var filtered = !string.IsNullOrWhiteSpace(query);
    string PageUrl(int p) => Url.Action("Index", new { page = p, q = query, field })!;

    string EditJson(SaleListDto s) => JsonSerializer.Serialize(new { Id = s.Id, BookTitle = s.BookTitle, AuthorId = s.AuthorId, StoreLocation = s.StoreLocation, SalePrice = s.SalePrice, Quantity = s.Quantity, BasicExpenses = s.BasicExpenses });
    string DeleteJson(SaleListDto s) => JsonSerializer.Serialize(new { id = s.Id, book = s.BookTitle, author = s.AuthorName, total = Format.Money(s.TotalAmount) + " ج.م" });
    var fields = new[] { ("book", "اسم الكتاب"), ("author", "الكاتب"), ("code", "كود الكاتب"), ("store", "المنفذ") };
}

<header class="page-head">
    <div>
        <h1 class="page-head__title">سجل المبيعات</h1>
        <p class="page-head__sub">تسجيل ومتابعة كل عمليات البيع حسب الكتاب والمؤلف والمنفذ</p>
    </div>
    <div class="page-head__actions">
        <div class="menu">
            <button type="button" class="btn btn--secondary" data-menu aria-haspopup="true" aria-expanded="false">@Icon.Svg("download", 18)تصدير</button>
            <div class="menu__panel" role="menu">
                <a class="menu__item" role="menuitem" asp-action="ExportPdf">@Icon.Svg("file-text", 18)تصدير PDF</a>
                <a class="menu__item" role="menuitem" asp-action="Export">@Icon.Svg("download", 18)تصدير Word</a>
            </div>
        </div>
        @if (isSuperAdmin)
        {
            <button type="button" class="btn btn--secondary" data-open="bulk-modal">@Icon.Svg("pen-square", 18)تعديل المصروفات</button>
        }
        <button type="button" class="btn btn--primary" data-open="sale-drawer" data-reset>@Icon.Svg("plus", 18)عملية جديدة</button>
    </div>
</header>

<section class="kpi-grid" aria-label="مؤشرات المبيعات">
    <partial name="_Kpi" model='new KpiModel("إجمالي العمليات", totalCount.ToString(), Note: filtered ? "حسب البحث الحالي" : "عملية بيع", IconName: "receipt")' />
    <partial name="_Kpi" model='new KpiModel("إجمالي المبالغ (صافي)", Format.Money(totalRevenue), "ج.م", "بعد خصم مصروفات النسخ", Tip: "الصافي: بعد خصم المصروفات. إيراد لوحة الإدارة خام قبل الخصم.", IconName: "wallet")' />
    <partial name="_Kpi" model='new KpiModel("كتب مباعة", totalQuantity.ToString("N0"), Note: "نسخة", IconName: "book")' />
    <partial name="_Kpi" model='new KpiModel("إجمالي المصروفات", Format.Money(totalExpenses), "ج.م", "مصروف النسخة × الكمية", IconName: "tag")' />
</section>

<section class="card">
    <div class="toolbar">
        <form class="toolbar__search" method="get" asp-action="Index" role="search">
            <label class="searchbar">
                @Icon.Svg("search", 20)
                <input type="search" name="q" value="@query" placeholder="ابحث في سجل المبيعات..." aria-label="بحث" />
                @if (filtered)
                {
                    <a class="searchbar__clear" asp-action="Index" asp-route-field="@field" aria-label="مسح البحث">@Icon.Svg("x", 18)</a>
                }
            </label>
            <div class="filter-chips" role="radiogroup" aria-label="البحث في">
                @foreach (var (value, label) in fields)
                {
                    <label class="chip-radio">
                        <input type="radio" name="field" value="@value" checked="@(field == value)" />
                        <span class="chip">@label</span>
                    </label>
                }
            </div>
            <button type="submit" class="sr-only">بحث</button>
        </form>
        <span class="muted toolbar__hint" style="font-size:14px">اضغط Enter للبحث</span>
    </div>

    @if (Model.Any())
    {
        <div class="table-wrap table-wrap--responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>الكتاب</th><th>المنفذ</th><th class="col-num">الكمية</th><th class="col-num">السعر</th>
                        <th class="col-num">المصروفات</th><th class="col-num">المجموع</th><th>التاريخ</th><th class="col-actions"><span class="sr-only">إجراءات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-stack">
                                    <b>@sale.BookTitle</b>
                                    <span class="cell-stack__sub">@sale.AuthorName<span class="code-chip">@sale.AuthorCode</span></span>
                                </div>
                            </td>
                            <td>@sale.StoreLocation</td>
                            <td class="col-num">@sale.Quantity</td>
                            <td class="col-num">@Format.Money(sale.SalePrice)</td>
                            <td class="col-num muted">@Format.Money(sale.BasicExpenses)</td>
                            <td class="col-num strong">@Format.Money(sale.TotalAmount)<span class="cur">ج.م</span></td>
                            <td class="num muted nowrap" style="font-size:14px">@Format.DateTimeStamp(sale.SaleDate)</td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <button type="button" class="btn btn--icon" data-edit="@EditJson(sale)" data-edit-target="sale-edit" title="تعديل" aria-label="تعديل @sale.BookTitle">@Icon.Svg("pencil", 20)</button>
                                    @if (isSuperAdmin)
                                    {
                                        <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@sale.Id" data-delete="@DeleteJson(sale)" data-delete-target="delete-sale" title="حذف" aria-label="حذف @sale.BookTitle">@Icon.Svg("trash", 20)</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mcards">
            @foreach (var sale in Model)
            {
                <article class="mcard">
                    <div class="mcard__top">
                        <div class="cell-stack">
                            <div class="mcard__title">@sale.BookTitle</div>
                            <span class="cell-stack__sub">@sale.AuthorName<span class="code-chip">@sale.AuthorCode</span></span>
                        </div>
                        <div class="mcard__total">@Format.Money(sale.TotalAmount)<span class="cur">ج.م</span></div>
                    </div>
                    <dl class="mcard__meta">
                        <div><dt>الكمية</dt><dd>@sale.Quantity</dd></div>
                        <div><dt>السعر</dt><dd>@Format.Money(sale.SalePrice)</dd></div>
                        <div><dt>المنفذ</dt><dd>@sale.StoreLocation</dd></div>
                    </dl>
                    <div class="mcard__foot">
                        <span class="mcard__date num">@Format.DateTimeStamp(sale.SaleDate)</span>
                        <div class="row-actions">
                            <button type="button" class="btn btn--icon" data-edit="@EditJson(sale)" data-edit-target="sale-edit" aria-label="تعديل">@Icon.Svg("pencil", 20)</button>
                            @if (isSuperAdmin)
                            {
                                <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@sale.Id" data-delete="@DeleteJson(sale)" data-delete-target="delete-sale" aria-label="حذف">@Icon.Svg("trash", 20)</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <partial name="_Pagination" model="new PagerModel(currentPage, totalPages, totalCount, 10, PageUrl)" />
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyModel(filtered ? "لا توجد نتائج مطابقة" : "لا توجد مبيعات بعد", filtered ? "جرّب كلمة أخرى أو غيّر حقل البحث" : "سجّل أول عملية بيع لتظهر هنا")' />
    }
</section>

<button type="button" class="fab" data-open="sale-drawer" data-reset aria-label="عملية جديدة">@Icon.Svg("plus", 26)</button>

@section Overlays {
    <aside class="drawer" id="sale-drawer" role="dialog" aria-modal="true" aria-labelledby="sale-drawer-title" aria-hidden="true">
        <div class="drawer__head">
            <h2 class="drawer__title" id="sale-drawer-title">تسجيل عملية جديدة</h2>
            <button type="button" class="btn btn--icon" data-close aria-label="إغلاق">@Icon.Svg("x", 20)</button>
        </div>
        <partial name="_SaleForm" model='"Create"' />
    </aside>

    <aside class="drawer" id="sale-edit" role="dialog" aria-modal="true" aria-labelledby="sale-edit-title" aria-hidden="true">
        <div class="drawer__head">
            <h2 class="drawer__title" id="sale-edit-title">تعديل عملية بيع</h2>
            <button type="button" class="btn btn--icon" data-close aria-label="إغلاق">@Icon.Svg("x", 20)</button>
        </div>
        <partial name="_SaleForm" model='"Edit"' />
    </aside>

    @if (isSuperAdmin)
    {
        <partial name="_DeleteModal" model='new DeleteModalModel("delete-sale", "حذف عملية البيع؟", "الحذف نهائي ولا يمكن التراجع عنه.", "Admin", "Sale",
            new List<KeyValuePair<string, string>> { new("book", "الكتاب"), new("author", "المؤلف"), new("total", "الإجمالي") })' />

        <div class="modal" id="bulk-modal" role="dialog" aria-modal="true" aria-labelledby="bulk-title" aria-hidden="true">
            <div class="modal__panel">
                <form asp-action="BulkEditExpenses" method="post" data-once>
                    <input type="hidden" name="q" value="@query" />
                    <input type="hidden" name="field" value="@field" />
                    <div class="modal__head">
                        <span class="modal__icon modal__icon--warn">@Icon.Svg("alert-triangle")</span>
                        <div>
                            <h2 class="modal__title" id="bulk-title">تعديل المصروفات جماعياً</h2>
                            <p class="modal__text">سيتغيّر مصروف النسخة لكل السجلات المطابقة للبحث الحالي، ويُعاد حساب الإجمالي لكل سجل.</p>
                        </div>
                    </div>
                    <div class="modal__body">
                        <dl class="facts">
                            <div class="facts__row"><dt>السجلات المتأثرة</dt><dd class="num">@totalCount</dd></div>
                            <div class="facts__row"><dt>البحث الحالي</dt><dd>@(filtered ? "«" + query + "»" : "بدون بحث — كل السجلات")</dd></div>
                        </dl>
                        <div class="field">
                            <label class="field__label" for="bulk-value">المصروفات الجديدة للنسخة (ج.م)</label>
                            <input class="input input--num" id="bulk-value" name="newBasicExpenses" type="number" step="0.01" min="0" required placeholder="0.00" inputmode="decimal" />
                        </div>
                    </div>
                    <div class="modal__foot">
                        <button type="button" class="btn btn--secondary" data-close>إلغاء</button>
                        <button type="submit" class="btn btn--primary">تأكيد التعديل</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
