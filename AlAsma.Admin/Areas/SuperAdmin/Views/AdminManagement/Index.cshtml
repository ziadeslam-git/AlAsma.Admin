@model IEnumerable<AuthorListDto>
@using System.Text.Json
@{
    ViewData["Title"] = "إدارة Admins";
}

<header class="page-head">
    <div>
        <h1 class="page-head__title">إدارة Admins</h1>
        <p class="page-head__sub">حسابات المديرين الذين يديرون الموقع نيابةً عنك</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--primary" asp-action="Create">@Icon.Svg("plus", 18)Admin جديد</a>
    </div>
</header>

<section class="card">
    @if (Model.Any())
    {
        <div class="table-wrap table-wrap--responsive">
            <table class="table">
                <thead><tr><th>المدير</th><th>الكود</th><th class="col-actions"><span class="sr-only">إجراءات</span></th></tr></thead>
                <tbody>
                    @foreach (var admin in Model)
                    {
                        var data = JsonSerializer.Serialize(new { id = admin.Id, name = admin.Name, code = admin.Code });
                        <tr>
                            <td>
                                <div class="cell-stack"><b>@admin.Name</b><span class="cell-stack__sub">مدير</span></div>
                            </td>
                            <td><span class="code-chip">@admin.Code</span></td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="btn btn--icon" asp-action="Edit" asp-route-id="@admin.Id" title="تعديل" aria-label="تعديل @admin.Name">@Icon.Svg("pencil", 20)</a>
                                    <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@admin.Id" data-delete="@data" data-delete-target="delete-admin" title="حذف" aria-label="حذف @admin.Name">@Icon.Svg("trash", 20)</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mcards">
            @foreach (var admin in Model)
            {
                var data = JsonSerializer.Serialize(new { id = admin.Id, name = admin.Name, code = admin.Code });
                <article class="mcard">
                    <div class="mcard__top">
                        <div class="cell-stack"><div class="mcard__title">@admin.Name</div><span class="cell-stack__sub"><span class="code-chip">@admin.Code</span></span></div>
                        <div class="row-actions">
                            <a class="btn btn--icon" asp-action="Edit" asp-route-id="@admin.Id" aria-label="تعديل">@Icon.Svg("pencil", 20)</a>
                            <a class="btn btn--icon btn--icon-danger" asp-action="Delete" asp-route-id="@admin.Id" data-delete="@data" data-delete-target="delete-admin" aria-label="حذف">@Icon.Svg("trash", 20)</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <partial name="_EmptyState" model='new EmptyModel("لا يوجد مديرون بعد", "أضف Admin ليدير الموقع نيابةً عنك")' />
    }
</section>

@section Overlays {
    <partial name="_DeleteModal" model='new DeleteModalModel("delete-admin", "حذف المدير؟", "سيُحذف الحساب حذفاً ناعماً ولن يتمكن من الدخول بعد الآن.", "SuperAdmin", "AdminManagement",
        new List<KeyValuePair<string, string>> { new("name", "الاسم"), new("code", "الكود") })' />
}
